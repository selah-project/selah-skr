{"tier":"glm-5.2","verse":1,"ref":"ezra 2:1","book":"ezra","lang":"skr","chapter":2,"translation":"تے ایہ او صوبے دے پُتر ہن جیہڑے جلاوطنی دی قید توں، جینکوں بابل دا بادشاہ نِبوکدنِتصّر بابل گھن ڳیا ہا، اُتھاہوں اُتے آئے، تے او یروشلایم تے یہوداہ وِچ وَل آئے، ہر بندہ آپݨے شہر وِچ۔","tokens":[{"surface":"ואלה","gloss":"تے ایہ"},{"surface":"בני","gloss":"پُتر"},{"surface":"המדינה","gloss":"صوبے دے"},{"surface":"העלים","gloss":"اُتے آئے"},{"surface":"משבי","gloss":"قید توں"},{"surface":"הגולה","gloss":"جلاوطنی دی"},{"surface":"אשר","gloss":"جینکوں"},{"surface":"הגלה","gloss":"گھن ڳیا ہا"},{"surface":"נבוכדנצור","gloss":"نِبوکدنِتصّر"},{"surface":"מלך","gloss":"بادشاہ"},{"surface":"בבל","gloss":"بابل دا"},{"surface":"לבבל","gloss":"بابل وِچ"},{"surface":"וישובו","gloss":"وَل آئے"},{"surface":"לירושלם","gloss":"یروشلایم وِچ"},{"surface":"ויהודה","gloss":"تے یہوداہ وِچ"},{"surface":"איש","gloss":"ہر بندہ"},{"surface":"לעירו","gloss":"آپݨے شہر وِچ"}],"timestamp":"2026-09-19T20:25:46.933412362Z","model":"glm-5.3"}